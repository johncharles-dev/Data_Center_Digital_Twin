__pycache__/
*.pyc
.ipynb_checkpoints/

# Live-simulator local output (not the training dataset — that's
# regenerated from dataset/generate_dataset.py, never committed)
room_data.csv
room_data.json
crac_data.csv
crac_data.json

# Local broker artifacts if you run mosquitto manually
*.pid
mosquitto.log

# Trained model — large (verify size before committing; see README
# section 12.2). Uncomment the line below if you'd rather regenerate
# it at deploy time than commit it.
# models/*.joblib

.env
.venv/
venv/

# Broker secrets. Generated locally by mosquitto/make_credentials.sh and never
# committed, so a fresh clone carries no credentials and cannot connect to
# anyone else's broker. Regenerate with ./run.sh or the script directly.
mosquitto/passwd
mosquitto/credentials.json
mosquitto/certs/
mosquitto/.runtime/

# Audit trail — local decision record, not source.
logs/

# Dashboard runtime config: contains the read-only `viewer` broker
# credential, generated by serve_demo.sh. Read-only or not, a password does
# not belong in git.
dashboard/config.js
